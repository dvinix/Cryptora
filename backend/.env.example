# Database Configuration (PostgreSQL URL)
DATABASE_URL=postgresql://cryptora_user:your_password_here@localhost:5432/cryptora_db

# API Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME=Cryptora
VERSION=1.0.0
DESCRIPTION=End-to-end encrypted notepad with zero-knowledge architecture

# Security - CORS configuration (comma-separated origins or *)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://cryptora.vercel.app
CORS_ALLOW_CREDENTIALS=false

# Security - JWT configuration
JWT_SECRET_KEY=generate_a_secure_random_64_character_hex_key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Security Limits
MAX_CONTENT_SIZE=1000000
MAX_ALIAS_LENGTH=100
MIN_ALIAS_LENGTH=1

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
